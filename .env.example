# Voice Cloning System — configuration (all optional; every var is prefixed VC_)
# Copy to .env and export, or set directly in your shell.

# --- server ---
VC_HOST=127.0.0.1
VC_PORT=8000
# VC_CORS_ORIGINS=*                # comma-separated list

# --- engine ---
VC_ENGINE=f5                       # f5 = real model | fake = offline stub for dev/CI
VC_MODEL=F5TTS_v1_Base             # SWivid/F5-TTS v1 base checkpoint
VC_DEVICE=                         # empty = auto (cuda if available, else cpu)
VC_QUANTIZED=0                     # int8 dynamic quantization (CPU only) — see scripts/benchmark.py
VC_NFE_STEPS=32                    # ODE solver steps; 16 is ~2x faster with slightly softer quality
VC_CFG_STRENGTH=2.0
VC_SPEED=1.0
VC_DEFAULT_LANGUAGE=en             # en | hi | bn | fr | zh | ta | te | mr | gu | kn | ml | or | pa | as
VC_MAX_LOADED_MODELS=2             # multilingual checkpoint pool size (LRU eviction)
VC_WHISPER_MODEL=base              # faster-whisper size for reference transcription (base|small|...)
VC_TORCH_THREADS=0                 # inference threads; 0 = all logical cores (torch default is physical)
VC_HF_ETAG_TIMEOUT=5               # seconds before HF metadata checks fall back to local cache
# VC_HF_TOKEN=                     # only needed for gated repos (default registry is ungated)
# VC_LANGUAGE_MODELS={"de":{"repo":"user/F5-German","ckpt_file":"model.safetensors","vocab_file":"vocab.txt","languages":["de"]}}

# --- behavior ---
VC_PRELOAD=1                       # load model in background at startup
VC_CONSENT_REQUIRED=1              # require consent=true when enrolling / uploading references
VC_ENABLE_SIMILARITY=1             # ECAPA speaker-embedding scoring
VC_ENABLE_TRANSCRIPTION=1          # auto-transcribe references when ref_text is omitted
VC_MAX_TEXT_CHARS=5000
VC_STREAM_CHUNK_CHARS=180

# --- audio / storage ---
VC_SAMPLE_RATE=24000
VC_MIN_REF_SECONDS=3
VC_MAX_REF_SECONDS=30
VC_MAX_UPLOAD_MB=25
VC_DATA_DIR=./data
VC_ENABLE_CACHE=1
VC_CACHE_MAX_FILES=200
